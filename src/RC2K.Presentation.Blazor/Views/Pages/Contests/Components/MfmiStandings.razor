@using Microsoft.Extensions.Caching.Memory
@using RC2K.Presentation.Blazor.Views.Pages.Contests.Mfmi24
@using RC2K.Utils
@inject ITimeEntryService TimeEntryService
@inject INotificationService NotificationService
@inject IUserService UserService
@inject MessageHelper MessageHelper
@inject IStageService StageService
@inject ICarService CarService
@inject IMemoryCache Cache

<div style="width: 100%; display: flex; justify-content: center;">
    <MudButtonGroup Variant="Variant.Filled" Color="Color.Primary">
        @foreach (var x in LevelHelper.GetRallyCodesBySimulationOrder())
        {
            <MudButton Href="@($"/contests/{MainLink}/standings/{LevelHelper.RallyCodeToRallyShortName(x)}")" Style="font-size: 8pt; text-transform: none;">
                @LevelHelper.RallyCodeToRallyName(x)
            </MudButton>
        }
    </MudButtonGroup>
</div>
@if (_isLoading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@($"100vh")" />
    <MudOverlay Visible="true" Absolute="true">
        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
    </MudOverlay>
}
else
{
    @foreach (var stage in _viewModel.Stages)
    {
        <div style="display: grid; grid-template-columns: 1fr 4fr; border-top: solid black 1px; margin-top: 10px;">
            <div style="display: flex; flex-direction: column; justify-content: flex-start; align-items: center;">
                <h1>@stage.StageName</h1>
                <img src="@(stage.IsRallySummary ? $"img/rallies/{stage.StageImage}.PNG" : $"img/maps/{stage.StageImage}")" />
            </div>
            <MudDataGrid T="EntryListItemViewModel"
            Items="@stage.Entries"
            ShowColumnOptions="false">
                <Columns>
                    <PropertyColumn Property="x => x.Rank" Title="Rank" Filterable="false" Sortable="false" />
                    <PropertyColumn Property="x => x.Nr" Title="#" Filterable="false" Sortable="false" />
                    <PropertyColumn Property="@(x => x.Driver.Known ? x.Driver.User.Name : x.Driver.Name)" Title="Name" Filterable="false" Sortable="false" />
                    <TemplateColumn Title="Car">
                        <CellTemplate>
                            <div class="car" data-car-id="@(context.Item.Car.Id - 1)"></div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Nat" >
                        <CellTemplate>
                            <span class="fi @($"fi-{@context.Item.Driver!.Nationality}")"></span>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="@(x => $"G{x.Group}")" Title="Group" Filterable="false" Sortable="false" />
                    <PropertyColumn Property="x => x.TimeDisplay" Title="Time" Filterable="false" Sortable="false" />
                    <PropertyColumn Property="x => x.GapDisplay" Title="Gap" Filterable="false" Sortable="false" />
                    @if (!stage.IsRallySummary)
                    {
                        <TemplateColumn Title="Proofs" Filterable="false" Sortable="false">
                            <CellTemplate>
                                <p style="display: flex;">
                                    @{
                                        foreach (var p in context.Item.Proofs.OrderBy(x => x.Type))
                                        {
                                            <MudIconButton Target="_blank" Class="proof-item" Icon="@IconMapper.ProofTypeToIcon(p.Type)" Href="@p.Url" Size="Size.Small" />
                                        }
                                    }
                                </p>
                            </CellTemplate>
                        </TemplateColumn>
                    }
                </Columns>
            </MudDataGrid>
        </div>
    }
}
@code {

    private bool _isLoading = false;
    private RallyContestInfoViewModel _viewModel;


    [Parameter]
    public RallyCode RallyCode { get; set; }

    [Parameter]
    public string MainLink { get; set; }

    [Parameter]
    public string LabelFilter { get; set; }

    [Parameter]
    public Func<string,int> GetNrFunc { get; set; }

    [Parameter]
    public Func<string, string> GetGroupFunc { get; set; }

    [Parameter]
    public Func<string, string> GetCarFunc { get; set; }

    class RallyContestInfoViewModel
    {
        public List<StageContestInfoViewModel> Stages = [];
    }

    class StageContestInfoViewModel
    {
        public string StageName { get; set; }
        public string StageImage { get; set; }
        public bool IsRallySummary { get; set; }
        public List<EntryListItemViewModel> Entries = [];
    }

    class EntryListItemViewModel
    {
        public int Rank { get; set; }
        public int Nr { get; init; }
        public Driver Driver { get; set; }
        public string Group { get; init; }
        public Car Car { get; init; }
        public TimeSpan Time { get; set; }
        public string TimeDisplay => (Time == TimeSpan.MaxValue) ? "N/A" : Time.ToString(@"m\:ss\.ff");
        public TimeSpan Gap { get; set; }
        public string GapDisplay => TimeDisplay == "N/A" ? "N/A" : (Gap == TimeSpan.Zero ? "" : $"- {Gap.ToString(@"m\:ss\.ff")}");
        public List<Proof> Proofs { get; set; }
    }

    private async Task<Car> ResolveCar(string driverName)
    {
        string carName = GetCarFunc(driverName);
        List<Car> cars = await CarService.GetAll();
        return cars.First(x => x.Name == carName);
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _isLoading = true;
            await Reload();
        }
        finally
        {
            _isLoading = false;
        }

    }

    private async Task Reload()
    {
        _viewModel = new();

        var stages = (await StageService.GetAllByRallyCode(RallyCode))
            .Where(x => x.Direction == DomainModel.Direction.Simulation)
            .ToList();

        List<StageContestInfoViewModel> stagesViewModel = [];
        Dictionary<int, List<Mfmi24Helper.StandingsInfo>> standingsByStageId = new();
        foreach (var s in stages)
        {
            var standings = await Mfmi24Helper.GetStandingsInfo(TimeEntryService, s, LabelFilter);
            var vm = await GetViewModelForStage(s, standings);

            stagesViewModel.Add(vm);
            standingsByStageId[s.Id] = standings;
        }


        var rallyStandingsInfo = Mfmi24Helper.GetRallyStandingsInfo(standingsByStageId);

        var globalVm = await GetViewModelForSummary(rallyStandingsInfo);
        stagesViewModel.Add(globalVm);

        _viewModel.Stages = stagesViewModel;
    }

    private string GetStageViewModelCacheKey(int stageId) =>
        $"MfmiStandings_{MainLink}_{RallyCode}_{stageId}";

    private string GetGlobalViewModelCacheKey() =>
        $"MfmiStandings_{MainLink}_{RallyCode}_GLOBAL";

    private async Task<StageContestInfoViewModel> GetViewModelForStage(Stage stage, List<Mfmi24Helper.StandingsInfo> standings)
    {
        string cacheKey = GetStageViewModelCacheKey(stage.Id);
        var cachedValue = Cache.Get<StageContestInfoViewModel>(cacheKey);
        if (cachedValue is not null)
        {
            return cachedValue;
        }

        StageContestInfoViewModel vm = new();
        vm.StageName = stage.StageData.Name;
        vm.StageImage = stage.StageData.ImgName;
        vm.Entries = new();

        vm.Entries = standings.Select(s => new EntryListItemViewModel()
        {
            Car = ResolveCar(s.Driver.FriendlyName).GetAwaiter().GetResult(), // TODO
            Driver = s.Driver,
            Nr = GetNrFunc(s.Driver.FriendlyName),
            Gap = s.Gap,
            Group = GetGroupFunc(s.Driver.FriendlyName),
            Proofs = s.Proofs,
            Rank = s.Rank,
            Time = s.Time
        }).ToList();

        Cache.Set<StageContestInfoViewModel>(cacheKey, vm);
        return vm;
    }

    private async Task<StageContestInfoViewModel> GetViewModelForSummary(List<Mfmi24Helper.StandingsInfo> standingsByStageId)
    {
        string cacheKey = GetGlobalViewModelCacheKey();
        var cachedValue = Cache.Get<StageContestInfoViewModel>(cacheKey);
        if (cachedValue is not null)
        {
            return cachedValue;
        }

        StageContestInfoViewModel vm = new();
        vm.StageName = LevelHelper.RallyCodeToRallyName(RallyCode);
        vm.StageImage = LevelHelper.RallyCodeToRallyImageName(RallyCode);
        vm.IsRallySummary = true;
        vm.Entries = new();

        vm.Entries = standingsByStageId.Select(s => new EntryListItemViewModel()
        {
            Car = ResolveCar(s.Driver.FriendlyName).GetAwaiter().GetResult(), // TODO
            Driver = s.Driver,
            Nr = GetNrFunc(s.Driver.FriendlyName),
            Gap = s.Gap,
            Group = GetGroupFunc(s.Driver.FriendlyName),
            Proofs = s.Proofs,
            Rank = s.Rank,
            Time = s.Time
        }).ToList();

        Cache.Set<StageContestInfoViewModel>(cacheKey, vm);
        return vm;
    }
}