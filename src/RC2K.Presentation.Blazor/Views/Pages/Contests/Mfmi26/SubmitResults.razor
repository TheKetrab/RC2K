@rendermode InteractiveServer

@page "/contests/mfmi26/submit"
@using RC2K.Presentation.Blazor.AuthProxy
@using RC2K.Presentation.Blazor.Views.Pages.Contests.Components
@inherits BaseMfmi26Page
@inject ITimeEntryService TimeEntryService
@inject INotificationService NotificationService
@inject IUserService UserService
@inject MessageHelper MessageHelper
@inject IDriverService DriverService
@inject ICarService CarService
@inject AuthenticationStateProvider Asp

@if (_isLoggedIn)
{
    <MfmiSubmit Label="@base.Contest.MainLink.ToUpper()" 
                CarId="@_carId"
                DriverName="@_fixedDriverName"
                GetCompetitionDayFunc="_getCompetitionDayFunc" 
                ValidatePreviousDaysFromCurrentRally="ValidatePreviousDaysFromCurrentRally" />
}
else
{
    <MudText>Only logged in users can submit results</MudText>
}

@code {

    private int? _carId;
    private string? _fixedDriverName;
    private bool _isLoggedIn;

    [SupplyParameterFromQuery]
    public int? CompetitionDay { get; set; }

    [SupplyParameterFromQuery]
    public string? FixedDriver { get; set; }

    [SupplyParameterFromQuery]
    public bool ValidatePreviousDaysFromCurrentRally { get; set; } = false;

    private Func<int> _getCompetitionDayFunc;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Asp.GetAuthenticationStateAsync();
        if (CompetitionDay is not null && Auth.TryAuthorize(auth, Auth.AdminRole))
        {
            int compDay = CompetitionDay.Value;
            _getCompetitionDayFunc = () => compDay;
        }
        else
        {
            _getCompetitionDayFunc = Mfmi26Helper.GetCompetitionDay;
        }

        if (!Auth.TryAuthorize(auth, Auth.AdminRole))
        {
            ValidatePreviousDaysFromCurrentRally = true;
        }

        var current = await UserService.GetCurrentUserName();
        Driver? currentDriver;
        if (FixedDriver is not null && Auth.TryAuthorize(auth, Auth.AdminRole))
        {
            currentDriver = await DriverService.GetByName(FixedDriver);
        }
        else
        {
            currentDriver = await DriverService.GetByName(current);
        }

        if (currentDriver is null)
        {
            _isLoggedIn = false;
            return;            
        }

        _isLoggedIn = true;
        _fixedDriverName = currentDriver.FriendlyName;

        var carName = Mfmi26Helper.GetCar(currentDriver.FriendlyName);
        Car? car = (await CarService.GetAll()).FirstOrDefault(x => x.Name == carName);
        _carId = car?.Id;
    }
}