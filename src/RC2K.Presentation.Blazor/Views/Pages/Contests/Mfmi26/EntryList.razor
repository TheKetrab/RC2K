@rendermode InteractiveServer

@page "/contests/mfmi26/entry-list"

@inject IDriverService DriverService
@inject ICarService CarService

<MudDataGrid T="EntryListItemViewModel"
             Items="@_items"
             Hover="true"
             Breakpoint="Breakpoint.Sm"
             ReadOnly="false"
             Bordered="true"
             Dense="true">
    <Columns>
        <PropertyColumn Property="x => x.Nr" Title="#" />
        <PropertyColumn Property="@(x => x.Driver.Known ? x.Driver.User.Name : x.Driver.Name)" Title="Name" />
        <TemplateColumn Title="Nationality">
            <CellTemplate>
               <span class="fi @($"fi-{@context.Item.Driver!.Nationality}")"></span>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="@(x => $"G{x.Group}")" Title="Group" />
        <PropertyColumn Property="x => x.Car.Name" Title="Car" />
        <TemplateColumn Title="Driver profile">
            <CellTemplate>
                <MudButton Href="@context.Item.DriverProfile">
                    Show
                </MudButton>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>


@code {

    private List<EntryListItemViewModel> _items;

    class EntryListItemViewModel
    {
        public int Nr { get; init; }
        public Driver Driver { get; set; }
        public int Group { get; init; }
        public Car Car { get; init; }
        public string DriverProfile { get; init; }
    }

    protected override async Task OnInitializedAsync()
    {
        _items = new ();

        var cars = await CarService.GetAll();
        var c1 = cars.First();
        var c2 = cars.Skip(1).First();

        var theKetrab = await DriverService.GetByName("TheKetrab");
        var ephemeral = await DriverService.GetByName("Ephemeral");
        _items.Add(new EntryListItemViewModel()
        {
            Nr = 10,
            Car = c1,
            Driver = theKetrab,
            DriverProfile = "",
            Group = 2
        });
        _items.Add(new EntryListItemViewModel()
        {
            Nr = 25,
            Car = c2,
            Driver = ephemeral,
            DriverProfile = "",
            Group = 1
        });

    }

}