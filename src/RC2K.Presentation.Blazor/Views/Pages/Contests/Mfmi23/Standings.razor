@rendermode InteractiveServer

@using RC2K.Presentation.Blazor.Views.Pages.Contests.Components
@using RC2K.Utils;

@page "/contests/mfmi23/standings"
@page "/contests/mfmi23/standings/{rally}"
@inherits BaseMfmi23Page

<MfmiStandings MainLink="@Contest.MainLink" 
               RallyCode="RallyCode"
               LabelFilter="MFMI23"
               GetGroupFunc="Mfmi23Helper.GetGroup"
               GetNrFunc="Mfmi23Helper.GetNr"
               GetCarFunc="Mfmi23Helper.GetCar"/>


@code {

    [Parameter]
    public string? Rally { get; set; }

    private RallyCode RallyCode => Rally is null
        ? LevelHelper.GetRallyCodesBySimulationOrder().First()
        : LevelHelper.GetRallyCodeByShortName(Rally);

}