@rendermode InteractiveServer
@page "/stages/{name}"
@page "/stages"

@inject IStageService StageService


<style>
    .stage-table .mud-table-cell {
        padding: 2px 8px 2px 8px !important;
        font-size: clamp(.5rem, 2vw, 1em) !important;
    }

    .stage-table .mud-table-cell a.mud-typography-body1 {
        font-size: inherit !important;
    }
    .stages-content {
        display: flex;
        gap: 20px;
        height: calc(100vh - 200px);
    }
    .stages-content-list {
        flex: 1;
        overflow-y: auto;
        min-width: 0;

        
    }
    .stages-content-map {
        flex: 1;
    }
    .stages-content-map-wrapper {
         overflow: hidden;
         border: 1px solid #ddd;
         border-radius: 4px;
    }
    @@media (max-width: 768px) {
        .stages-content {
            flex-direction: column;
            height: auto;
        }
        .stages-content-list {
            order: 2;
            height: auto;
        }
        .stages-content-map {
            order: 1;
        }
    }

</style>
<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudText Typo="Typo.h4" GutterBottom="true">Stages (@(Name is not null ? GetRallyFullName(Name) : "All"))</MudText>

    <div class="stages-content">
        <!-- Left side: Table -->
        <div class="stages-content-list">
            <MudTable Items="@_stages"
                Breakpoint="Breakpoint.None"
                      T="Stage"
                      Hover="true"
                      Class="stage-table"
                      Elevation="4"
                      Dense="true"
                      GroupBy="@_groupDefinition">
                <HeaderContent>
                    <MudTh><div style="display: flex; flex-direction: column;"><span>Name</span><span>.</span></div></MudTh>
                    <MudTh><div style="display: flex; flex-direction: column; align-items: center;"><span>Length</span><span>(km)</span></div></MudTh>
                    <MudTh><div style="display: flex; flex-direction: column; align-items: center;"><span>Terrain</span><span>(%)</span></div></MudTh>
                    <MudTh><div style="display: flex; flex-direction: column; align-items: center;"><span>Temp</span><span>(&deg;C)</span></div></MudTh>
                    <MudTh><div style="display: flex; flex-direction: column; align-items: center;"><span>Wind</span><span>(km/h)</span></div></MudTh>
                    <MudTh><div style="display: flex; flex-direction: column; align-items: center;"><span>Moods</span><span>.</span></div></MudTh>
                </HeaderContent>

                <GroupHeaderTemplate>
                    <MudTh Class="mud-theme-primary-light" colspan="9">
                        <MudText Typo="Typo.subtitle1"><b>@context.Key</b></MudText>
                    </MudTh>
                </GroupHeaderTemplate>

                <RowTemplate>
                    <MudTd style="width: fit-content" DataLabel="Name">
                        @{
                            string routeName = Name ?? RC2K.Utils.LevelHelper.GetRallyCodeByStageCode(context.Code).ToString().ToLower();
                        }
                            <MudLink href="@($"/stages/{routeName}/{context.Code}?direction={context.Direction}")" Color="Color.Primary">
                            <b>@(context.StageData?.Name ?? "Unknown")</b> @(context.Direction == DomainModel.Direction.Arcade ? "(A)" : "")
                        </MudLink>
                    </MudTd>
                    <MudTd DataLabel="Length">@context.StageData?.StageDetails?.Length</MudTd>
                    <MudTd DataLabel="Terrain">@context.StageData?.StageDetails?.Asphalt / @context.StageData?.StageDetails?.Dirt / @context.StageData?.StageDetails?.Gravel / @context.StageData?.StageDetails?.Snow</MudTd>
                    <MudTd DataLabel="Temp">@context.StageData?.StageDetails?.Temp</MudTd>
                    <MudTd DataLabel="Wind">@context.StageData?.StageDetails?.Wind</MudTd>
                    <MudTd DataLabel="Moods">
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var mood in GetMoods(context.StageData?.StageDetails?.Mood))
                            {
                                <MudChip Class="mud-chip-size-xs" T="string" Size="Size.Small" Variant="Variant.Filled" Color="@GetMoodColor(mood)">@mood</MudChip>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>

        <!-- Right side: Map -->
        <div class="stages-content-map">
            <div class="stages-content-map-wrapper">
            @if (_stages.Any())
            {
                <MultiMap Waypoints="@_allWaypoints" MultiMapPaths="@_combinedPaths" StartsEnds="@_startsEnds" />
            }
            else
            {
                <MudText Typo="Typo.body1" Class="pa-4">Loading map...</MudText>
            }
            </div>
        </div>
    </div>
</MudContainer>
