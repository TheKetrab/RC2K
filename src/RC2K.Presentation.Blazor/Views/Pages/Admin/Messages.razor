@rendermode InteractiveServer

@page "/admin/messages"

@inject IMessageService MessageService
@inject MessageHelper MessageHelper
@inject ILogger<Messages> Logger

<MudDataGrid T="MessageItemViewModel"
             Items="@_messages"
             MultiSelection="true"
             Hover="true"
             Breakpoint="Breakpoint.Sm"
             EditMode="DataGridEditMode.Cell"
             ColumnResizeMode="ResizeMode.Column"
             RowStyleFunc="RowStyleFunc"
             ReadOnly="false"
             Bordered="true"
             Dense="true"
             EditTrigger="DataGridEditTrigger.OnRowClick">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Messages</MudText>
        <MudText>Date & Time in CET/CEST (Local Poland time)</MudText>
        <MudSpacer />
        <MudButtonGroup Class="ma-0 pa-0" Color="Color.Success" Variant="Variant.Filled">
            <MudButton OnClick="NewItemAsync">
                Add New Item
            </MudButton>
        </MudButtonGroup>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="Id" Editable="false" Filterable="false" Style="width: 80px"/>
        <PropertyColumn Property="x => x.Name" Title="Name" Sortable="false" Filterable="false" Required="false" />
        <PropertyColumn Property="x => x.Published" Title="Published" Sortable="false" Filterable="false">
            <EditTemplate>
                <MudCheckBox @bind-Value="context.Item.Published" />
            </EditTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Date & time" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudTextField @bind-Value="context.Item.Time"
                              Validation="(string dateTime) => ValidateDateTime(dateTime)" />
            </CellTemplate>
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Time"
                              Validation="(string dateTime) => ValidateDateTime(dateTime)" />
            </EditTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Message" Title="Message definition" Sortable="false" Filterable="false" />
        <TemplateColumn Title="Actions" Width="80px" Sortable="false" Filterable="false" Editable="false">
            <CellTemplate>
                <div class="d-flex justify-space-between align-center">
                    <MudIconButton Size="@Size.Small"
                                   Icon="@(context.Item.IsDeleted ? Icons.Material.Outlined.Restore : Icons.Material.Outlined.Delete)"
                                   OnClick="@(() => DeleteItemClicked(context.Item))" />
                    <MudIconButton Size="@Size.Small"
                                   Disabled="@(!context.Item.IsDirty)"
                                   Icon="@(Icons.Material.Outlined.Refresh)"
                                   OnClick="@(() => ResetItemClicked(context.Item))" />
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>    
    <PagerContent>
        <MudTablePager />
        <MudButton Class="ma-1" Color="Color.Primary" Variant="Variant.Filled" OnClick="Update" Disabled="@(!AnyToUpdate)">
            Update
        </MudButton>
    </PagerContent>
</MudDataGrid>
