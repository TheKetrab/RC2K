@using RC2K.Presentation.Shared.Layout
@using RC2K.Presentation.Shared.ViewModels

@inherits BaseNavMenu

<nav>
    <AppLoading />
    @foreach (var menuItem in MenuItems.Where(x => x.Item != "Admin"))
    {
        @RenderMenuItem(menuItem)
    }
    <div class="profile" style="align-self: center;">
        <LoginButton />
    </div>
</nav>
